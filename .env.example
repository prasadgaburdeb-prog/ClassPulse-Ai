# Application Environment: development, test, staging, production
APP_ENV=development

# Database connection URL
# SQLite default for local development. For MySQL use:
# DATABASE_URL=mysql+pymysql://classpulse:YOUR_PASSWORD@localhost/classpulse
DATABASE_URL=sqlite:///./classpulse.db

# Cryptographically secure random JWT signing key (min 32 characters, 64 recommended)
# In production, startup FAILS if this is missing or uses a default/compromised value.
# Generate one using: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-secure-random-64-character-secret-in-production

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_ISSUER=classpulse-ai
JWT_AUDIENCE=classpulse-client
ACCESS_TOKEN_TTL_MINUTES=30

# Cookie Configuration
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Comma-separated allowed browser origins for CORS (leave blank for same-origin only)
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate limiting storage (leave blank for local shared SQLite/in-memory store)
RATE_LIMIT_STORE_URL=

# Upload size limits
MAX_UPLOAD_MB=15

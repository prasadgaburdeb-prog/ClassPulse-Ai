# SQLite is used by default for local development. For MySQL set this value, e.g.:
# DATABASE_URL=mysql+pymysql://classpulse:YOUR_PASSWORD@localhost/classpulse
DATABASE_URL=sqlite:///./classpulse.db
SECRET_KEY=replace-this-before-hosting
MAX_UPLOAD_MB=5
# Comma-separated browser origins allowed in hosted deployments. Leave blank for local use.
ALLOWED_ORIGINS=
# Set true only behind HTTPS in hosted environments.
COOKIE_SECURE=false
